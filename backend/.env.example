# 应用配置
APP_NAME=e-ArchivesSystem
APP_ENV=development
DEBUG=true

# 数据库
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/e_archives_system?charset=utf8mb4

# JWT
SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 附件存储
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=20
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf

# 到期提醒
EXPIRE_REMIND_DAYS=30

# 分类二次密码解锁 token 有效期（分钟）
CATEGORY_UNLOCK_EXPIRE_MINUTES=30
